# Read by `expo start` (Expo auto-loads .env and inlines every EXPO_PUBLIC_* var).
#
# WHY THIS FILE EXISTS: EXPO_PUBLIC_API_URL lives in eas.json's build.*.env, and that
# only applies to an EAS build. In dev the var was unset, so src/constants/config.js
# fell back to deriving http://<dev-machine-LAN-IP>:5000 from Metro's host URI — which
# only reaches a backend if the phone happens to be on the same Wi-Fi as the laptop.
# On mobile data, a guest network, or with AP isolation, every request died and the
# screens rendered empty. Pointing dev at the deployed API makes `expo start` behave
# like the installed build.
EXPO_PUBLIC_API_URL=https://ailernova-api.onrender.com

# Working on the server? Create .env.local (gitignored, and it WINS over this file):
#   EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:5000
