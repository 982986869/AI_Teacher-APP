{
  "expo": {
    "name": "ailernova",
    "slug": "ailernova",
    "owner": "ailernova_ai",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2A0569"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ailernova.teacher"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "com.ailernova.teacher"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Ailernova adds your booked demo class to your calendar so you get a reminder before it starts."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_REVERSED_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ailernova needs access to your photos so you can add images to questions and upload study material.",
          "cameraPermission": "Ailernova needs camera access so you can photograph notes or textbook pages to upload as study material."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ailernova uses your microphone so you can talk to your AI teacher and ask doubts by voice.",
          "speechRecognitionPermission": "Ailernova uses speech recognition so your AI teacher can understand your spoken questions."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "dccd04ea-7d70-4833-8530-b551448b5b05"
      },
      "google": {
        "webClientId": "87773466841-e4mu2gmd5evup3gg6vf58hqs0ogumvas.apps.googleusercontent.com"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dccd04ea-7d70-4833-8530-b551448b5b05",
      "fallbackToCacheTimeout": 0
    }
  }
}
