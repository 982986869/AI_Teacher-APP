# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (PostgreSQL) ────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/ailernova_db"

# ─── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-random-hex-string
JWT_EXPIRES_IN=7d

# ─── AI Provider ──────────────────────────────────────────
# Which provider to use: "anthropic" (only supported option for now)
AI_PROVIDER=anthropic

# Master switch for AI calls (lessons, doubts, AND BrainGym question generation).
#   MOCK_AI=true  → NO Claude calls. BrainGym uses its deterministic, grade-safe
#                   fallback generator. Lessons/doubts use mock responses.
#   MOCK_AI=false → real Claude is used WHEN ANTHROPIC_API_KEY is also set.
MOCK_AI=true

# Your Anthropic API key from https://console.anthropic.com
# BrainGym AI generation is ENABLED only when: MOCK_AI=false AND this key is set
# AND AI_PROVIDER=anthropic. Otherwise BrainGym silently uses the fallback
# generator (questions are still valid, grade-safe and numeric — just templated).
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model for lesson generation (high-quality, structured output).
# claude-opus-5 is a drop-in upgrade at the same price if you want it.
AI_LESSON_MODEL=claude-opus-4-8

# Model for doubt Q&A (fast, conversational)
AI_DOUBT_MODEL=claude-haiku-4-5

# Optional: small deterministic sub-tasks — intent classification, quiz drafting,
# answer grading. Short in, short out, and answerDoubt runs while the student is
# waiting mid-lesson, so cheap and fast wins. Falls back to AI_DOUBT_MODEL.
# AI_CHEAP_MODEL=claude-haiku-4-5

# Optional: RAG answering + document extraction ("Ask the Material"). This wants
# the OPPOSITE of AI_CHEAP_MODEL — a whole uploaded PDF has to fit in context, and
# answers must stay grounded in the retrieved material.
#
#   ‼️ Do NOT point this at a 200K-context model. A large PDF is then silently
#      truncated — no error is raised, the answers are just built from part of the
#      material. Use a 1M-context model: claude-sonnet-5 (cheaper) or an Opus.
#
# Falls back to AI_LESSON_MODEL when unset.
# AI_KNOWLEDGE_MODEL=claude-sonnet-5

# ─── Embeddings (BrainGym duplicate detection + RAG) ──────
# Voyage AI key. When set, generated BrainGym questions get a 1024-dim vector
# stored in question_embeddings (used for semantic duplicate detection).
# Optional — signature + token-overlap dedup works without it.
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5-lite
EMBEDDING_DIM=1024

# ─── How to enable REAL BrainGym AI generation ────────────
# 1. Set MOCK_AI=false
# 2. Set ANTHROPIC_API_KEY=sk-ant-...
# 3. (optional) Set VOYAGE_API_KEY for semantic dedup
# 4. Restart the server. Server logs will then show origins: { ai_generated: N }
#    instead of { fallback_generated: N }.

# ─── Image storage (Supabase Storage) ────────────────────
# Powers admin content-image upload (question / option diagrams). The uploaded
# image's public URL is embedded as <img> in the question/option HTML.
# Setup once:
#   1. Supabase dashboard → Storage → New bucket → name it "content-images" → PUBLIC.
#   2. Project Settings → API → copy the URL and the service_role key below.
# When these are unset, image upload returns a clear "not configured" error and
# every other feature keeps working.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=content-images

# ─── Teacher voice (Text-to-Speech) ───────────────────────
# All narration streams from /api/tts. PRIMARY = ElevenLabs, with NO automatic
# fallback: the teacher has one voice, and switching it mid-lesson on a quota
# error reads as a bug to the student. So the key below is load-bearing — without
# it the app drops to on-device Expo Speech, which sounds like a different (and
# noticeably worse) teacher.
#
# PAID PLAN REQUIRED: a free ElevenLabs account cannot use the TTS API at all;
# it answers 402 paid_plan_required on every request.
#
# The voice id is a VOICE LIBRARY voice. Add it to the account first
# ("Add to my voices" in the library) or the API returns 404 for that id.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Ghr5KCyOzBvJpcdBbJhE
# eleven_flash_v2_5 is the cheap, low-latency model. eleven_multilingual_v2 sounds
# better and costs more per character.
# ELEVENLABS_MODEL=eleven_flash_v2_5

# The other provider, reachable by changing TTS_PROVIDER above.
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=coral
# ElevenLabs — premium voice, paid plan required. Set TTS_PROVIDER=elevenlabs
# to make it primary. There is no fallback chain: a failure surfaces as a non-2xx.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Also used by the AI/embedding layer, not just TTS.
OPENAI_API_KEY=

# ─── HeyGen streaming avatar (tester-gated, real per-minute cost ~$0.20/min) ──
# Real-time WebRTC video avatar for the live teacher, see server/src/routes/avatar.js.
# OFF by default (HEYGEN_ENABLED unset/false) even with a key present — flip it
# on only for tester accounts (TESTER_EMAILS above) while validating cost/quality.
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=
# HEYGEN_ENABLED=false
# HEYGEN_SESSION_DURATION_SEC=600
# HEYGEN_IDLE_TIMEOUT_SEC=300
# HEYGEN_QUALITY=medium
# HEYGEN_MAX_CONCURRENT=4

# ─── Phone OTP login (MSG91) — NOT WIRED UP YET ───────────
# config.sms is read by nothing today: there is no OTP route or controller in
# server/src. Auth is email+password only. These keys are here for when phone
# login is actually built — leaving them empty changes no behaviour.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_EXPIRY_MIN=5

# ─── RAG retrieval tuning ─────────────────────────────────
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.2

# ─── Feature flags (rollout gates; code default = OFF when unset) ──────────
# With every flag OFF/unset the app behaves exactly as before.
#
# PERSIST_CHECKS — persist per-slide check/reteach so RESUMED lessons carry them.
#   Requires the nullable Slide.check/reteach columns applied via `prisma db push`
#   BEFORE turning this on. Leave OFF until those columns exist.
PERSIST_CHECKS=false
#
# DIAGNOSTIC_GATE — close the in-lesson check → durable mastery loop: the server
#   resolves the concept (exact subject+chapter+name match — never guesses) and folds
#   the check outcome into student_concepts. OFF ⇒ /check accepts but writes nothing
#   (recorded:false). Enabled after QA of the /check flow.
DIAGNOSTIC_GATE=true

# ─── Tester allowlist ─────────────────────────────────────
# Comma-separated emails that may switch between every class from one login.
# The only case where a client-supplied ?class= is trusted — keep it empty in
# a real production deploy unless you intend it. Also gates access to the
# HeyGen streaming avatar (see below) since that has a real per-minute cost.
TESTER_EMAILS=

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces).
# Unset ⇒ dev: reflect any origin; production: deny cross-origin browser requests.
# It can NOT be "*": the API sends credentials: true, and browsers reject
# `Access-Control-Allow-Origin: *` on credentialed requests.
# Note: the native app and the admin portal (Next.js server-side rewrite) both
# send no Origin header, so this only constrains browsers hitting the API directly.
# Expo Go on Android: exp://192.168.x.x:8081
# Expo Go on iOS:     exp://192.168.x.x:19000
# Web:                http://localhost:19006
ALLOWED_ORIGINS=http://localhost:19006,exp://localhost:8081

# ─── Google Sign-In ───────────────────────────────────────
# OAuth 2.0 client IDs from Google Cloud Console → APIs & Services → Credentials.
# These are the audiences an incoming Google ID token is accepted for. At minimum
# GOOGLE_WEB_CLIENT_ID must be set: Android issues tokens audienced to the WEB
# client, not the Android one. Without any of these, POST /api/auth/google
# returns 503 "Google sign-in is not configured on this server".
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
