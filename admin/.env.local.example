# Where the existing Express backend lives. The Next dev server proxies /api/* here
# (see next.config.mjs) so the browser stays same-origin — no CORS setup needed.
ADMIN_API_PROXY=http://localhost:5000

# The portal proxies /api/* to the backend, but Next rewrites do not carry a WebSocket
# upgrade — the socket connects to the backend origin directly.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
